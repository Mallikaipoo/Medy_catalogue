# Copy to infra/.env (never commit .env)
POSTGRES_DB=medycatalog
POSTGRES_USER=medycatalog
POSTGRES_PASSWORD=medycatalog_dev
MINIO_ROOT_USER=medycatalog
MINIO_ROOT_PASSWORD=medycatalog_devpass

# Backend (export in your shell or IDE run config)
# DATABASE_URL=jdbc:postgresql://localhost:5432/medycatalog
# DATABASE_USER=medycatalog
# DATABASE_PASSWORD=medycatalog_dev
# MEDYCATALOG_JWT_SECRET=replace-with-32-plus-random-bytes-dev-only
# GOOGLE_OAUTH_CLIENT_ID=
# APPLE_BUNDLE_ID=in.claris.medycatalog
